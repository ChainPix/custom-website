    "command": "curl -X POST https://api.example.com/items -H \"Content-Type: application/json\" -d '{\"name\":\"Sample\",\"active\":true}'"
  },
  {
    "name": "post-json-multi-d",
    "command": "curl -X POST https://api.example.com/items -H \"Content-Type: application/json\" -d '{\"name\":\"first\"}' -d '{\"name\":\"second\"}'"
  },
  {
    "name": "post-form",
    "command": "curl -X POST https://api.example.com/login -H \"Content-Type: application/x-www-form-urlencoded\" -d \"username=demo\" -d \"password=secret\""
  },
  {
    "name": "post-form-multi-d",
    "command": "curl -X POST https://api.example.com/auth -d \"grant_type=client_credentials\" -d \"scope=read\""
